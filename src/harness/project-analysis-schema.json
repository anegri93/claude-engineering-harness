{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string" },
    "architecture_summary": { "type": "string" },
    "key_modules": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "responsibility": { "type": "string" },
          "depends_on": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string" }
          },
          "evidence_paths": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string" }
          }
        },
        "required": ["path", "responsibility", "depends_on", "evidence_paths"]
      }
    },
    "always_on_rules": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string" }
    },
    "business_invariants": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule": { "type": "string" },
          "evidence_paths": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string" }
          }
        },
        "required": ["rule", "evidence_paths"]
      }
    },
    "rule_groups": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "filename": { "type": "string", "description": "Bare kebab-case topic slug: no directory, no .md extension, no harness- prefix (the harness adds its own). Name the topic. Do not echo back a rule filename you can see in the repository. Use the same language as `title`." },
          "title": { "type": "string" },
          "paths": {
            "type": "array",
            "maxItems": 12,
            "items": { "type": "string" }
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": { "type": "string" }
          },
          "evidence_paths": {
            "type": "array",
            "maxItems": 12,
            "items": { "type": "string" }
          },
          "rationale": { "type": "string" }
        },
        "required": ["filename", "title", "paths", "rules", "evidence_paths", "rationale"]
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "impact": { "type": "string", "enum": ["data_loss", "security", "incorrect_result", "maintenance", "cosmetic"], "description": "What breaks if this goes wrong. data_loss: data destroyed, corrupted, or left inconsistent. security: a trust or authorization boundary is crossed or weakened. incorrect_result: the system returns a wrong answer, or silently skips work it reports having done. maintenance: it works, but is costly or dangerous to change. cosmetic: output, naming or documentation, with no behavioural consequence." },
          "trigger": { "type": "string", "enum": ["already_occurring", "normal_use", "specific_conditions", "hypothetical"], "description": "What must happen for the HARM to occur, not for the code path to run. already_occurring: observable right now in the tree or at runtime. normal_use: any ordinary use path reaches it. specific_conditions: needs a particular environment, timing or input. hypothetical: no known path today, a latent weakness. Example: an unpinned global install of a package at @latest runs on every initialization, but the harm needs a bad version to be published first, so it is hypothetical rather than already_occurring." },
          "blast_radius": { "type": "string", "enum": ["system_wide", "component", "local"], "description": "How far the consequence reaches. system_wide: every user, project or session. component: one module or subsystem. local: one file or call site." },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "evidence_paths": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "string" }
          },
          "recommendation": { "type": "string" }
        },
        "required": ["impact", "trigger", "blast_radius", "title", "detail", "evidence_paths", "recommendation"]
      }
    },
    "confidence_notes": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string" }
    }
  },
  "required": [
    "summary",
    "architecture_summary",
    "key_modules",
    "always_on_rules",
    "business_invariants",
    "rule_groups",
    "risks",
    "confidence_notes"
  ]
}
