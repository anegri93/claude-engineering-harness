{
  "model": "claude-opus-5",
  "effortLevel": "high",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/mark-baseline-dirty.sh",
            "timeout": 10,
            "statusMessage": "Tracking engineering baseline impact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/verify-project.sh",
            "timeout": 900,
            "statusMessage": "Verifying code and refreshing engineering baseline"
          }
        ]
      }
    ]
  }
}
