# macOS
.DS_Store

# Node
node_modules/
npm-debug.log*
pnpm-debug.log*

# Runtime state generated by the harness, never source
harness-backups/
harness-runtime/
.claude/baseline-dirty

# Graft's generated context cards. Derived from source and regenerated by `graft build`,
# so committing them adds churn; leaving them untracked-but-not-ignored is worse, because
# the Stop hook reads `git ls-files --others` to decide whether anything happened.
/graft/

# Local env
.env
.env.local
